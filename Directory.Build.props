<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Vestigium</Authors>
    <Company>Wilkinson Business</Company>
    <Copyright>Copyright (c) 2026 Nathaniel Wilkinson</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    <VestigiumNetworkVersion>1.5.6</VestigiumNetworkVersion>
    <VestigiumAnalyticsVersion>1.0.1</VestigiumAnalyticsVersion>
    <VestigiumChartsVersion>1.0.9</VestigiumChartsVersion>
    <VestigiumLoggingVersion>1.7.1</VestigiumLoggingVersion>
    <VestigiumThemesVersion>1.0.6</VestigiumThemesVersion>
    <VestigiumControlsVersion>1.0.0</VestigiumControlsVersion>
    <VestigiumStatusBarVersion>1.0.1</VestigiumStatusBarVersion>
    <VestigiumNumericUpDownVersion>1.0.2</VestigiumNumericUpDownVersion>
    <VestigiumUnderConstructionVersion>1.0.1</VestigiumUnderConstructionVersion>
    <VestigiumConvertersVersion>1.0.0</VestigiumConvertersVersion>
    <VestigiumPerfMonVersion>0.1.1</VestigiumPerfMonVersion>
    <VestigiumPerfMonCoreVersion>0.1.6</VestigiumPerfMonCoreVersion>
    <VestigiumPerfMonCpuVersion>0.1.2</VestigiumPerfMonCpuVersion>
    <VestigiumPerfMonMemoryVersion>0.1.2</VestigiumPerfMonMemoryVersion>
    <VestigiumSystemInfoVersion>0.1.1</VestigiumSystemInfoVersion>
    <VestigiumQueryBarVersion>1.0.3</VestigiumQueryBarVersion>
    <VestigiumClosedXmlVersion>1.0.1</VestigiumClosedXmlVersion>
    <VestigiumKqlVersion>1.0.4</VestigiumKqlVersion>
    <VestigiumLogParserVersion>1.0.0</VestigiumLogParserVersion>
    <VestigiumLogParserHarVersion>1.0.0</VestigiumLogParserHarVersion>
    <VestigiumLogParserUrlVersion>1.0.0</VestigiumLogParserUrlVersion>
    <VestigiumWatchDnsVersion>1.0.15</VestigiumWatchDnsVersion>
    <MicrosoftExtensionsDiVersion>10.0.12</MicrosoftExtensionsDiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Vestigium.Suite.Network.Documentation'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Vestigium.Suite.Network.Documentation'">
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Vestigium.Suite.Network.Documentation'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Link="LICENSE" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Link="README.md" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
