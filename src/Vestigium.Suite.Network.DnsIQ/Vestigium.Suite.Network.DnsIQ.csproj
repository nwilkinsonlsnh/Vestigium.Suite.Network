<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Vestigium.Suite.Network.DnsIQ</RootNamespace>
    <AssemblyName>DnsIQ</AssemblyName>
    <ApplicationTitle>DnsIQ</ApplicationTitle>
    <ApplicationIcon>Assets\DnsIQ.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vestigium.Suite.Network.Shell\Vestigium.Suite.Network.Shell.csproj" />
    <Resource Include="Assets\DnsIQ.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12">
      <PrivateAssets>none</PrivateAssets>
      <IncludeAssets>all</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Vestigium.Themes" Version="$(VestigiumThemesVersion)" />
    <PackageReference Include="Vestigium.Controls" Version="$(VestigiumControlsVersion)" />
    <PackageReference Include="Vestigium.Controls.StatusBar" Version="$(VestigiumStatusBarVersion)" />
    <PackageReference Include="Vestigium.Controls.NumericUpDown" Version="$(VestigiumNumericUpDownVersion)" />
    <PackageReference Include="Vestigium.Controls.UnderConstruction" Version="$(VestigiumUnderConstructionVersion)" />
    <PackageReference Include="Vestigium.Converters" Version="$(VestigiumConvertersVersion)" />
    <PackageReference Include="Vestigium.Helpers.Analytics" Version="$(VestigiumAnalyticsVersion)" />
    <PackageReference Include="Vestigium.Helpers.Charts" Version="$(VestigiumChartsVersion)" />
    <PackageReference Include="Vestigium.Helpers.ClosedXml" Version="$(VestigiumClosedXmlVersion)" />
    <PackageReference Include="Vestigium.Helpers.LogParser" Version="$(VestigiumLogParserVersion)" />
    <PackageReference Include="Vestigium.Helpers.LogParser.Har" Version="$(VestigiumLogParserHarVersion)" />
    <PackageReference Include="Vestigium.Helpers.LogParser.Url" Version="$(VestigiumLogParserUrlVersion)" />
    <PackageReference Include="Vestigium.Helpers.Watch.Dns" Version="$(VestigiumWatchDnsVersion)" />
  </ItemGroup>

  <Target Name="CopyDiAbstractions" AfterTargets="Build">
    <PropertyGroup>
      <_DiRoot>$(NuGetPackageRoot)microsoft.extensions.dependencyinjection.abstractions\10.0.12\</_DiRoot>
      <_DiRoot Condition="!Exists('$(_DiRoot)')">$(UserProfile)\.nuget\packages\microsoft.extensions.dependencyinjection.abstractions\10.0.12\</_DiRoot>
    </PropertyGroup>
    <ItemGroup>
      <_DiAbstractions Include="$(_DiRoot)lib\**\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DiAbstractions)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_DiAbstractions)' != ''" />
    <Copy SourceFiles="@(_DiAbstractions)" DestinationFolder="$(OutputPath)watch\" SkipUnchangedFiles="true" Condition="'@(_DiAbstractions)' != ''" />
  </Target>
</Project>
