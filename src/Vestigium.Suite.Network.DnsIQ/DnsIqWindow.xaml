<Window x:Class="Vestigium.Suite.Network.DnsIQ.DnsIqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Vestigium.Controls.Shell;assembly=Vestigium.Controls"
        Title="DnsIQ"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Vestigium.Controls;component/Shell/MenuChrome.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Style="{StaticResource DockPanel.Standard}">
    <Menu DockPanel.Dock="Top" Style="{StaticResource Menu.Standard}">
      <MenuItem Header="_File" Style="{StaticResource MenuItem.Standard}">
        <MenuItem Header="E_xit" Style="{StaticResource MenuItem.Standard}" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_View" Style="{StaticResource MenuItem.Standard}">
        <MenuItem Header="Status bar _visible" Style="{StaticResource MenuItem.Standard}" IsCheckable="True" IsChecked="{Binding ShowStatusBar}" />
        <Separator Style="{StaticResource Separator.Menu}" />
        <MenuItem Header="Status bar at _Bottom" Style="{StaticResource MenuItem.Standard}" Command="{Binding DockStatusBarBottomCommand}" />
        <MenuItem Header="Status bar at _Top" Style="{StaticResource MenuItem.Standard}" Command="{Binding DockStatusBarTopCommand}" />
        <Separator Style="{StaticResource Separator.Menu}" />
        <MenuItem x:Name="ThemeMenu" Header="_Theme" Style="{StaticResource MenuItem.Standard}" />
      </MenuItem>
    </Menu>
    <ItemsControl DockPanel.Dock="Top"
                  Margin="12,0,12,0"
                  ItemsSource="{Binding NavItems, ElementName=RootShell}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                       Content="{Binding Header}"
                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                       IsEnabled="{Binding IsEnabled}"
                       GroupName="DnsIqMainNav"
                       Checked="MainNav_Checked"
                       Margin="0,0,8,0" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <shell:VestigiumShell x:Name="RootShell"
                          ShowNav="False"
                          Status="{Binding Status}"
                          StatusBarPosition="{Binding Status.Position, Mode=TwoWay}"
                          ShowStatusBar="{Binding ShowStatusBar}" />
  </DockPanel>
</Window>
