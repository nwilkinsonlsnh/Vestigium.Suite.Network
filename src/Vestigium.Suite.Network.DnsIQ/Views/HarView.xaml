<UserControl x:Class="Vestigium.Suite.Network.DnsIQ.Views.HarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Style="{StaticResource StackPanel.Toolbar}" Margin="0,0,0,12">
      <Button Content="Open capture…" Style="{StaticResource Button.Primary}" Command="{Binding OpenCaptureCommand}" Padding="16,4" Margin="0,0,8,0" />
      <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Padding="16,4" />
    </StackPanel>
    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Hosts}"
              Style="{StaticResource DataGrid.Compact}"
              RowHeight="28"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">
      <DataGrid.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="Lookup" Command="{Binding LookupHostCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          <MenuItem Header="Lookup + Probe" Command="{Binding LookupAndProbeCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*" />
        <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="120" />
        <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="80" />
        <DataGridTextColumn Header="Sources" Binding="{Binding Sources}" Width="180" />
        <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="120" />
        <DataGridTextColumn Header="Answers" Binding="{Binding Answers}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
