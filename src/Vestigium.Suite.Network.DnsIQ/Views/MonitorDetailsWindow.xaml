<Window x:Class="Vestigium.Suite.Network.DnsIQ.Views.MonitorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DnsIQ — Details"
        Width="1100"
        Height="640"
        MinWidth="800"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Style="{StaticResource StackPanel.Toolbar}" Margin="0,0,0,8">
      <Button Content="Close" Style="{StaticResource Button.Secondary}" Click="OnClose" Padding="16,4" Margin="0,0,8,0" />
      <Button Content="Lookup" Style="{StaticResource Button.Primary}" Click="OnLookup" Padding="16,4" Margin="0,0,8,0" />
    </StackPanel>
    <TextBlock x:Name="Caption" Grid.Row="1" Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <Border Grid.Row="2" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid x:Name="Lines"
                Style="{StaticResource DataGrid.Compact}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Auto"
                RowHeight="NaN">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
          <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="200" />
          <DataGridTextColumn Header="Pid" Binding="{Binding Pid}" Width="70" />
          <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="70" />
          <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="90" />
          <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="70" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
          <DataGridTextColumn Header="Answers" Binding="{Binding Answers}" Width="*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Padding" Value="0,4" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
