<Window x:Class="Vestigium.Suite.Network.DnsIQ.Views.MonitorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DnsIQ — Details"
        Width="1100"
        Height="640"
        MinWidth="800"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Style="{StaticResource StackPanel.Toolbar}" Margin="0,0,0,8">
      <Button Content="Close" Style="{StaticResource Button.Secondary}" Click="OnClose" Padding="16,4" Margin="0,0,8,0" />
    </StackPanel>
    <TextBlock x:Name="Caption" Grid.Row="1" Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <Border Grid.Row="2" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid x:Name="Lines"
                Style="{StaticResource DataGrid.Compact}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Auto"
                ContextMenuOpening="OnMenuOpening">
        <DataGrid.ContextMenu>
          <ContextMenu />
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="36">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ToggleButton Content="{Binding Glyph}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              Visibility="{Binding ExpanderVisibility}"
                              Click="OnExpand"
                              Padding="4,0"
                              Background="Transparent"
                              BorderThickness="0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Sequence" Binding="{Binding SequenceText}" Width="90" />
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
          <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="200" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
          <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="{Binding Indent}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
