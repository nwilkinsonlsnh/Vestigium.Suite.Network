<UserControl x:Class="Vestigium.Suite.Network.DnsIQ.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Style="{StaticResource DockPanel.Standard}" Margin="12">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Heading}" Text="Settings" Margin="0,0,0,12" />
    <TabControl Style="{StaticResource TabControl.Standard}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                TabStripPlacement="Top">
      <TabItem Header="Theme" Style="{StaticResource TabItem.Standard}">
        <StackPanel Style="{StaticResource StackPanel.FormGroup}"
                    Margin="0,16,0,0"
                    MaxWidth="420"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
          <Label Style="{StaticResource Label.Standard}" Content="Palette" />
          <ComboBox Style="{StaticResource ComboBox.Standard}"
                    ItemsSource="{Binding Themes}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Id"
                    SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}"
                    Margin="0,0,0,16" />

          <Label Style="{StaticResource Label.Standard}" Content="Status bar" />
          <ComboBox Style="{StaticResource ComboBox.Standard}"
                    ItemsSource="{Binding BarPositions}"
                    SelectedItem="{Binding BarPosition}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Probe" Style="{StaticResource TabItem.Standard}">
        <StackPanel Style="{StaticResource StackPanel.FormGroup}"
                    Margin="0,16,0,0"
                    MaxWidth="480"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
          <TextBlock Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                     Text="N lookups spaced across X seconds. Type All cycles A, AAAA, CNAME, MX, NS, PTR, TXT, SOA. The question is resolver stability, not the record set." />

          <Label Style="{StaticResource Label.Standard}" Content="Requests (N)" />
          <nud:VestigiumNumericUpDown Value="{Binding DefaultRequests, Mode=TwoWay}"
                                      SignMode="Unsigned"
                                      Minimum="1"
                                      Maximum="10000"
                                      Increment="10"
                                      PageIncrement="100"
                                      DecimalPlaces="0"
                                      Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                                      Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                      BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                                      Margin="0,0,0,16" />

          <Label Style="{StaticResource Label.Standard}" Content="Seconds (X)" />
          <nud:VestigiumNumericUpDown Value="{Binding DefaultSeconds, Mode=TwoWay}"
                                      SignMode="Unsigned"
                                      Minimum="1"
                                      Maximum="600"
                                      Increment="1"
                                      PageIncrement="30"
                                      DecimalPlaces="0"
                                      Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                                      Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                      BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
          <TextBlock Style="{StaticResource TextBlock.Caption}" Margin="0,8,0,0"
                     Text="Examples: 1000 over 60 s, or 1000 over 180 s." />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
