<UserControl x:Class="Vestigium.Suite.Network.DnsIQ.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Style="{StaticResource StackPanel.Toolbar}" Orientation="Horizontal" Margin="0,0,0,12">
      <Label Style="{StaticResource Label.Standard}" Content="Source" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="120" Style="{StaticResource ComboBox.Standard}" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Margin="0,0,16,0" />
      <Label Style="{StaticResource Label.Standard}" Content="Seconds" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="80" Style="{StaticResource ComboBox.Standard}" ItemsSource="{Binding Durations}" SelectedItem="{Binding Seconds}" Margin="0,0,16,0" />
      <Button Content="Start" Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}" Padding="16,4" Margin="0,0,8,0" />
      <Button Content="Stop" Style="{StaticResource Button.Secondary}" Command="{Binding StopCommand}" Padding="16,4" Margin="0,0,16,0" />
      <TextBlock Style="{StaticResource TextBlock.Caption}" Text="{Binding MonitorStatus}" VerticalAlignment="Center" />
    </StackPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextBlock.Caption}" Text="{Binding ElapsedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
      <ProgressBar Height="8" Minimum="0" Maximum="{Binding Seconds}" Value="{Binding Elapsed}" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}" Text="{Binding Unseen}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid ItemsSource="{Binding Rows}"
                Style="{StaticResource DataGrid.Compact}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="180" />
          <DataGridTextColumn Header="Pid" Binding="{Binding Pid}" Width="80" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
          <DataGridTextColumn Header="Resolver" Binding="{Binding ResolverCount}" Width="90" />
          <DataGridTextColumn Header="Port" Binding="{Binding PacketCount}" Width="80" />
          <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
