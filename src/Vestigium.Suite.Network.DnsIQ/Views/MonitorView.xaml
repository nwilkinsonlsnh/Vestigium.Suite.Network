<UserControl x:Class="Vestigium.Suite.Network.DnsIQ.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="120" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Margin="0,0,16,0" />
      <TextBlock Text="Seconds" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="80" ItemsSource="{Binding Durations}" SelectedItem="{Binding Seconds}" Margin="0,0,16,0" />
      <Button Content="Start" Command="{Binding StartCommand}" Padding="16,4" Margin="0,0,8,0" />
      <Button Content="Stop" Command="{Binding StopCommand}" Padding="16,4" Margin="0,0,16,0" />
      <TextBlock Text="{Binding MonitorStatus}" VerticalAlignment="Center" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="180" />
        <DataGridTextColumn Header="Pid" Binding="{Binding Pid}" Width="80" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
        <DataGridTextColumn Header="Resolver" Binding="{Binding ResolverCount}" Width="90" />
        <DataGridTextColumn Header="Port" Binding="{Binding PacketCount}" Width="80" />
        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
