<UserControl x:Class="Vestigium.Suite.Network.DnsIQ.Views.DnsIqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="DnsIQ" Margin="0,0,0,12" />

    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,12" />

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="120" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,8" />
      <Grid Grid.Column="1" Margin="0,0,16,8">
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="(localhost)"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   Opacity="0.45"
                   IsHitTestVisible="False"
                   Visibility="{Binding ShowNameHint, Converter={StaticResource BoolToVis}}" />
      </Grid>
      <TextBlock Grid.Column="2" Text="Server" VerticalAlignment="Center" Margin="0,0,8,8" />
      <ComboBox Grid.Column="3"
                IsEditable="True"
                ItemsSource="{Binding ServerOptions}"
                DisplayMemberPath="Label"
                SelectedValuePath="Address"
                SelectedValue="{Binding Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Text="{Binding Server, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                Margin="0,0,16,8" />
      <TextBlock Grid.Column="4" Text="Type" VerticalAlignment="Center" Margin="0,0,8,8" />
      <ComboBox Grid.Column="5" ItemsSource="{Binding RecordTypes}"
                SelectedItem="{Binding RecordType}" Margin="0,0,0,8" />

      <TextBlock Grid.Row="1" Text="Interface" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox Grid.Row="1" Grid.Column="1"
               Text="{Binding Bind.InterfaceIndex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8"
               ToolTip="Optional NIC index. 0 means do not pin." />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="Source" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
               Text="{Binding Bind.SourceAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
               ToolTip="Optional local IPv4/IPv6 to bind the UDP query to. Leave empty unless this box has more than one address and you must pick which one leaves the machine." />

      <TextBlock Grid.Row="2" Text="Requests (N)" VerticalAlignment="Center" Margin="0,0,8,8" />
      <nud:VestigiumNumericUpDown Grid.Row="2" Grid.Column="1"
                                  Value="{Binding RequestCount, Mode=TwoWay}"
                                  SignMode="Unsigned"
                                  Minimum="1" Maximum="10000" Increment="10" PageIncrement="100" DecimalPlaces="0"
                                  Margin="0,0,16,8" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="Seconds (X)" VerticalAlignment="Center" Margin="0,0,8,8" />
      <nud:VestigiumNumericUpDown Grid.Row="2" Grid.Column="3"
                                  Value="{Binding DurationSeconds, Mode=TwoWay}"
                                  SignMode="Unsigned"
                                  Minimum="1" Maximum="600" Increment="1" PageIncrement="30" DecimalPlaces="0"
                                  Margin="0,0,0,8" />

      <StackPanel Grid.Row="3" Grid.ColumnSpan="6" Orientation="Horizontal">
        <Button Content="Lookup" Command="{Binding LookupCommand}" Padding="16,4" Margin="0,0,8,0" />
        <Button Content="Probe" Command="{Binding ProbeCommand}" Padding="16,4" Margin="0,0,8,0" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,4" />
      </StackPanel>
    </Grid>

    <DataGrid ItemsSource="{Binding Answers}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="2*" />
        <DataGridTextColumn Header="Ttl" Binding="{Binding Ttl}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
