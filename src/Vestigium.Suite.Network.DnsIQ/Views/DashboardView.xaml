<UserControl x:Class="Vestigium.Suite.Network.DnsIQ.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Heading}" Text="Dashboard" Margin="0,0,0,12" />

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                   Content="Lookup"
                   IsChecked="{Binding LookupPageOpen}"
                   GroupName="DashboardPage"
                   Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                   Content="Probe"
                   IsChecked="{Binding ProbePageOpen}"
                   GroupName="DashboardPage" />
    </StackPanel>

    <Grid Visibility="{Binding LookupPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}"
                 Text="Run Lookup on the DnsIQ page."
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"
                 Visibility="{Binding HasLookupData, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
      <ContentControl Content="{Binding LookupChart}"
                      Visibility="{Binding HasLookupData, Converter={StaticResource BoolToVis}}" />
    </Grid>

    <ScrollViewer Visibility="{Binding ProbePageOpen, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   Text="Run Probe on the DnsIQ page."
                   Visibility="{Binding HasProbeData, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        <ContentControl Content="{Binding ProbeCurve}" Height="220" Margin="0,0,0,16"
                        Visibility="{Binding HasProbeData, Converter={StaticResource BoolToVis}}" />
        <ContentControl Content="{Binding ProbeShape}" Height="220" Margin="0,0,0,16"
                        Visibility="{Binding HasProbeData, Converter={StaticResource BoolToVis}}" />
        <ContentControl Content="{Binding ProbeControl}" Height="220"
                        Visibility="{Binding ShowProbeControl, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
