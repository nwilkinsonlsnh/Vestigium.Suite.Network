<UserControl x:Class="Vestigium.Suite.Network.SysInfoIQ.Views.SysInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="System"
                   IsChecked="{Binding SystemPageOpen}" GroupName="SysInfoCategory" Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Storage"
                   IsChecked="{Binding StoragePageOpen}" GroupName="SysInfoCategory" Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Network"
                   IsChecked="{Binding NetworkPageOpen}" GroupName="SysInfoCategory" Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Security"
                   IsChecked="{Binding SecurityPageOpen}" GroupName="SysInfoCategory" Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Software"
                   IsChecked="{Binding SoftwarePageOpen}" GroupName="SysInfoCategory" Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Processes"
                   IsChecked="{Binding ProcessesPageOpen}" GroupName="SysInfoCategory" Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Events"
                   IsChecked="{Binding EventsPageOpen}" GroupName="SysInfoCategory" />
    </StackPanel>
    <Grid Grid.Row="1">

    <Border Visibility="{Binding SystemPageOpen, Converter={StaticResource BoolToVis}}"
            BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
            BorderThickness="1">
      <DataGrid Style="{StaticResource DataGrid.Compact}"
                ItemsSource="{Binding SystemRows}"
                IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="240" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <DockPanel Visibility="{Binding StoragePageOpen, Converter={StaticResource BoolToVis}}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Disks"
                     IsChecked="{Binding DisksOpen}" GroupName="StorageSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Logical"
                     IsChecked="{Binding LogicalOpen}" GroupName="StorageSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Partitions"
                     IsChecked="{Binding PartitionsOpen}" GroupName="StorageSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Volumes"
                     IsChecked="{Binding VolumesOpen}" GroupName="StorageSection" />
      </StackPanel>

      <Border Visibility="{Binding DisksOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding DiskDrives}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*" />
            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceType}" Width="100" />
            <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGb}" Width="100" />
            <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="180" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
            <DataGridTextColumn Header="Parts" Binding="{Binding Partitions}" Width="60" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding LogicalOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding LogicalDisks}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Drive" Binding="{Binding DeviceId}" Width="70" />
            <DataGridTextColumn Header="Label" Binding="{Binding VolumeName}" Width="*" />
            <DataGridTextColumn Header="FS" Binding="{Binding FileSystem}" Width="70" />
            <DataGridTextColumn Header="Type" Binding="{Binding DriveType}" Width="90" />
            <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGb}" Width="100" />
            <DataGridTextColumn Header="Free (GB)" Binding="{Binding FreeGb}" Width="100" />
            <DataGridTextColumn Header="Free %" Binding="{Binding FreePercent}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding PartitionsOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Partitions}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Disk" Binding="{Binding DiskNumber}" Width="60" />
            <DataGridTextColumn Header="Part" Binding="{Binding PartitionNumber}" Width="60" />
            <DataGridTextColumn Header="Letter" Binding="{Binding DriveLetter}" Width="70" />
            <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGb}" Width="100" />
            <DataGridTextColumn Header="Offset (GB)" Binding="{Binding OffsetGb}" Width="100" />
            <DataGridTextColumn Header="Boot" Binding="{Binding IsBoot}" Width="70" />
            <DataGridTextColumn Header="System" Binding="{Binding IsSystem}" Width="70" />
            <DataGridTextColumn Header="Hidden" Binding="{Binding IsHidden}" Width="70" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding VolumesOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Volumes}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Letter" Binding="{Binding DriveLetter}" Width="70" />
            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
            <DataGridTextColumn Header="FS" Binding="{Binding FileSystem}" Width="70" />
            <DataGridTextColumn Header="Type" Binding="{Binding DriveType}" Width="90" />
            <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGb}" Width="100" />
            <DataGridTextColumn Header="Free (GB)" Binding="{Binding FreeGb}" Width="100" />
            <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="90" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>

    <DockPanel Visibility="{Binding NetworkPageOpen, Converter={StaticResource BoolToVis}}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="IP"
                     IsChecked="{Binding IpOpen}" GroupName="NetworkSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="DNS"
                     IsChecked="{Binding DnsOpen}" GroupName="NetworkSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="NICs"
                     IsChecked="{Binding NicsOpen}" GroupName="NetworkSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Routes"
                     IsChecked="{Binding RoutesOpen}" GroupName="NetworkSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="ARP"
                     IsChecked="{Binding ArpOpen}" GroupName="NetworkSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Listeners"
                     IsChecked="{Binding ListenersOpen}" GroupName="NetworkSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="TCP"
                     IsChecked="{Binding TcpOpen}" GroupName="NetworkSection" />
      </StackPanel>

      <Border Visibility="{Binding IpOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding IpConfigs}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140" />
            <DataGridTextColumn Header="Addresses" Binding="{Binding Addresses}" Width="*" />
            <DataGridTextColumn Header="Gateways" Binding="{Binding Gateways}" Width="140" />
            <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="160" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding DnsOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding DnsConfigs}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
            <DataGridTextColumn Header="DNS Servers" Binding="{Binding DnsServers}" Width="*" />
            <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix}" Width="180" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding NicsOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Nics}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
            <DataGridTextColumn Header="Mbps" Binding="{Binding SpeedMbps}" Width="80" />
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding RoutesOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Routes}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*" />
            <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="140" />
            <DataGridTextColumn Header="Next Hop" Binding="{Binding NextHop}" Width="140" />
            <DataGridTextColumn Header="IfIndex" Binding="{Binding InterfaceIndex}" Width="80" />
            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding ArpOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Arp}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" />
            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
            <DataGridTextColumn Header="IfIndex" Binding="{Binding InterfaceIndex}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding ListenersOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Listeners}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="70" />
            <DataGridTextColumn Header="Local" Binding="{Binding LocalAddress}" Width="*" />
            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding TcpOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Tcp}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Local" Binding="{Binding LocalAddress}" Width="*" />
            <DataGridTextColumn Header="LPort" Binding="{Binding LocalPort}" Width="70" />
            <DataGridTextColumn Header="Remote" Binding="{Binding RemoteAddress}" Width="*" />
            <DataGridTextColumn Header="RPort" Binding="{Binding RemotePort}" Width="70" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>

    <DockPanel Visibility="{Binding SecurityPageOpen, Converter={StaticResource BoolToVis}}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Profiles"
                     IsChecked="{Binding ProfilesOpen}" GroupName="SecuritySection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Rules"
                     IsChecked="{Binding RulesOpen}" GroupName="SecuritySection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Certificates"
                     IsChecked="{Binding CertificatesOpen}" GroupName="SecuritySection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Drivers"
                     IsChecked="{Binding DriversOpen}" GroupName="SecuritySection" />
      </StackPanel>

      <Border Visibility="{Binding ProfilesOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding FirewallProfiles}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="120" />
            <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="90" />
            <DataGridTextColumn Header="Inbound" Binding="{Binding DefaultInbound}" Width="*" />
            <DataGridTextColumn Header="Outbound" Binding="{Binding DefaultOutbound}" Width="*" />
            <DataGridTextColumn Header="Log Allowed" Binding="{Binding LogAllowed}" Width="100" />
            <DataGridTextColumn Header="Log Blocked" Binding="{Binding LogBlocked}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding RulesOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding FirewallRules}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
            <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="80" />
            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="90" />
            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80" />
            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="140" />
            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding CertificatesOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Certificates}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="70" />
            <DataGridTextColumn Header="Store" Binding="{Binding Store}" Width="120" />
            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
            <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="*" />
            <DataGridTextColumn Header="Thumbprint" Binding="{Binding Thumbprint}" Width="200" />
            <DataGridTextColumn Header="Expires" Binding="{Binding NotAfter}" Width="100" />
            <DataGridTextColumn Header="Key" Binding="{Binding HasPrivateKey}" Width="60" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding DriversOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding SignedDrivers}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" />
            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" />
            <DataGridTextColumn Header="Version" Binding="{Binding DriverVersion}" Width="120" />
            <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="140" />
            <DataGridTextColumn Header="Signed" Binding="{Binding IsSigned}" Width="70" />
            <DataGridTextColumn Header="Signer" Binding="{Binding Signer}" Width="140" />
            <DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>

    <DockPanel Visibility="{Binding SoftwarePageOpen, Converter={StaticResource BoolToVis}}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Installed"
                     IsChecked="{Binding InstalledOpen}" GroupName="SoftwareSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Hotfixes"
                     IsChecked="{Binding HotfixesOpen}" GroupName="SoftwareSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Features"
                     IsChecked="{Binding FeaturesOpen}" GroupName="SoftwareSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="ODBC"
                     IsChecked="{Binding OdbcOpen}" GroupName="SoftwareSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Environment"
                     IsChecked="{Binding EnvironmentOpen}" GroupName="SoftwareSection" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="SQL"
                     IsChecked="{Binding SqlOpen}" GroupName="SoftwareSection" />
      </StackPanel>

      <Border Visibility="{Binding InstalledOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding InstalledView}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="70" />
            <DataGridTextColumn Header="Arch" Binding="{Binding Arch}" Width="60" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" />
            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="160" />
            <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate}" Width="100" />
            <DataGridTextColumn Header="Hidden" Binding="{Binding Hidden}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding HotfixesOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Hotfixes}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="KB" Binding="{Binding HotFixId}" Width="120" />
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
            <DataGridTextColumn Header="Installed On" Binding="{Binding InstalledOn}" Width="140" />
            <DataGridTextColumn Header="Installed By" Binding="{Binding InstalledBy}" Width="160" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding FeaturesOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Features}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding OdbcOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding Odbc}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="70" />
            <DataGridTextColumn Header="Arch" Binding="{Binding Arch}" Width="60" />
            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding EnvironmentOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding EnvironmentVars}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Visibility="{Binding SqlOpen, Converter={StaticResource BoolToVis}}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding SqlServices}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
            <DataGridTextColumn Header="Display" Binding="{Binding DisplayName}" Width="*" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
            <DataGridTextColumn Header="Start" Binding="{Binding StartType}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>

    <Border Visibility="{Binding ProcessesPageOpen, Converter={StaticResource BoolToVis}}"
            BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding ProcessRows}"
                IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="240" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Visibility="{Binding EventsPageOpen, Converter={StaticResource BoolToVis}}"
            BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid Style="{StaticResource DataGrid.Compact}" ItemsSource="{Binding EventRows}"
                IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="Grid_PreviewMouseWheel">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="240" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    </Grid>
    <Border Grid.Row="0" Grid.RowSpan="2"
            Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
            Opacity="0.92"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
        <TextBlock Text="{Binding ProgressMessage}"
                   Style="{StaticResource TextBlock.Caption}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />
        <ProgressBar IsIndeterminate="True" Height="8" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
