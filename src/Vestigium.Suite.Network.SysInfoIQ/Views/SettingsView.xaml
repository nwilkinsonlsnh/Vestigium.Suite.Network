<UserControl x:Class="Vestigium.Suite.Network.SysInfoIQ.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,12">
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                   Content="General"
                   IsChecked="{Binding GeneralPageOpen}"
                   GroupName="SettingsPage"
                   Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                   Content="Theme"
                   IsChecked="{Binding ThemePageOpen}"
                   GroupName="SettingsPage" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="520"
                Margin="20,0,0,0"
                Visibility="{Binding GeneralPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                 Text="Output folder receives the timestamped inventory folder. Elevation improves completeness of later sections. Base summary does not require it." />

      <Label Style="{StaticResource Label.Standard}" Content="Output folder" />
      <TextBox Style="{StaticResource TextBox.Standard}"
               Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="420"
                Margin="20,0,0,0"
                Visibility="{Binding ThemePageOpen, Converter={StaticResource BoolToVis}}">
      <Label Style="{StaticResource Label.Standard}" Content="Palette" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding Themes}"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id"
                SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}"
                Margin="0,0,0,16" />

      <CheckBox Content="Status bar visible"
                Style="{StaticResource CheckBox.Standard}"
                IsChecked="{Binding BarVisible}"
                Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Status bar dock" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding BarPositions}"
                SelectedItem="{Binding BarPosition}" />
    </StackPanel>
  </DockPanel>
</UserControl>
