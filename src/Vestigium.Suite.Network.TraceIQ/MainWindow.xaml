<Window x:Class="Vestigium.Suite.Network.TraceIQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TraceIQ" Height="420" Width="720">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="TraceIQ" Margin="0,0,0,12" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox Grid.Column="1" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
      <Button Grid.Column="2" Content="Trace" Command="{Binding RunTraceCommand}" Margin="0,0,0,8" Padding="16,4" />
      <TextBlock Grid.Row="1" Text="Status" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Status}" Margin="0,0,0,8" />
      <TextBox Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Log}" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
    </Grid>
  </DockPanel>
</Window>
