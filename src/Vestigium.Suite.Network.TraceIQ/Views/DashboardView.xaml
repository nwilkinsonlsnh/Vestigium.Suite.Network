<UserControl x:Class="Vestigium.Suite.Network.TraceIQ.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="8,0,8,4">
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Pages}" Margin="20,0,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Content="{Binding Header}"
                       Style="{DynamicResource RadioButton.HorizontalTab}"
                       GroupName="DashHops"
                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                       Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       CommandParameter="{Binding}"
                       Margin="0,0,8,0" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="44,0,0,0">
        <RadioButton Content="All" Style="{DynamicResource RadioButton.Pill}"
                     GroupName="DashView" IsChecked="{Binding ViewIsAll, Mode=OneWay}"
                     Command="{Binding AllCommand}" Margin="0,0,8,0" />
        <RadioButton Content="IQR" Style="{DynamicResource RadioButton.Pill}"
                     GroupName="DashView" IsChecked="{Binding ViewIsIqr, Mode=OneWay}"
                     Command="{Binding ToggleIqrCommand}" Margin="0,0,8,0" />
        <RadioButton Content="Steady" Style="{DynamicResource RadioButton.Pill}"
                     GroupName="DashView" IsChecked="{Binding ViewIsSteady, Mode=OneWay}"
                     Command="{Binding ToggleSteadyCommand}" />
      </StackPanel>
      <Button Content="Legend" Style="{DynamicResource Button.Secondary}"
              Command="{Binding ToggleLegendCommand}" Padding="12,2"
              HorizontalAlignment="Right" />
    </Grid>
    <DockPanel DataContext="{Binding Selected}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0" Content="{Binding Chart}" Margin="0,0,0,2" />
        <ContentControl Grid.Row="1" Content="{Binding Control}" />
      </Grid>
    </DockPanel>
  </DockPanel>
</UserControl>
