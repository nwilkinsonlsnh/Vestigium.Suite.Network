<UserControl x:Class="Vestigium.Suite.Network.TraceIQ.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="All" Style="{DynamicResource Button.Secondary}"
                Command="{Binding AllCommand}" Padding="12,2" Margin="0,0,8,0" />
        <Button Content="Steady" Style="{DynamicResource Button.Secondary}"
                Command="{Binding ToggleSteadyCommand}" Padding="12,2" Margin="0,0,8,0" />
        <Button Content="IQR" Style="{DynamicResource Button.Secondary}"
                Command="{Binding ToggleIqrCommand}" Padding="12,2" Margin="0,0,8,0" />
        <Button Content="Legend" Style="{DynamicResource Button.Secondary}"
                Command="{Binding ToggleLegendCommand}" Padding="12,2" />
      </StackPanel>
      <TextBlock VerticalAlignment="Center">
        <Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold" />
        <Run Text="   " />
        <Run Text="{Binding Status, Mode=OneWay}" />
      </TextBlock>
    </DockPanel>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Pages}" Margin="20,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Content="{Binding Header}"
                       Style="{DynamicResource RadioButton.HorizontalTab}"
                       GroupName="DashHops"
                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                       Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       CommandParameter="{Binding}"
                       Margin="0,0,8,0" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <DockPanel DataContext="{Binding Selected}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0" Content="{Binding Chart}" Margin="0,0,0,8" />
        <ContentControl Grid.Row="1" Content="{Binding Control}" />
      </Grid>
    </DockPanel>
  </DockPanel>
</UserControl>
