<UserControl x:Class="Vestigium.Suite.Network.TraceIQ.Views.TraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,8" />
      <ComboBox Grid.Column="1"
                IsEditable="True"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Settings.Mru}"
                DisplayMemberPath="Target"
                Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                SelectedItem="{Binding SelectedMru}"
                Margin="0,0,16,8" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="Trace" Command="{Binding RunTraceCommand}" Padding="16,4" Margin="0,0,8,0" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,4" />
      </StackPanel>
    </Grid>
    <ProgressBar Grid.Row="1" Height="8" Margin="0,0,0,8"
                 Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding Progress}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Reached" Margin="0,0,8,0" />
      <TextBlock Text="{Binding Reached}" Margin="0,0,16,0" />
      <TextBlock Text="Protocol" Margin="0,0,8,0" />
      <TextBlock Text="{Binding Protocol}" />
    </StackPanel>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid x:Name="HopGrid" ItemsSource="{Binding Hops}"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                Style="{StaticResource DataGrid.Compact}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
        <DataGrid.Resources>
          <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1B4F72" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="Transparent" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Ttl" Binding="{Binding Ttl}" Width="60" />
          <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
