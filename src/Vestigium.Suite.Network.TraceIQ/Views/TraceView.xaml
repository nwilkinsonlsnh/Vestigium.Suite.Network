<UserControl x:Class="Vestigium.Suite.Network.TraceIQ.Views.TraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="120" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox Grid.Column="1" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" />
      <TextBlock Grid.Column="2" Text="Max hops" VerticalAlignment="Center" Margin="0,0,8,8" />
      <nud:VestigiumNumericUpDown Grid.Column="3" Value="{Binding MaxHops}" Minimum="1" Maximum="64" Margin="0,0,16,8" />
      <TextBlock Grid.Column="4" Text="Probes" VerticalAlignment="Center" Margin="0,0,8,8" />
      <nud:VestigiumNumericUpDown Grid.Column="5" Value="{Binding ProbesPerHop}" Minimum="1" Maximum="10" Margin="0,0,16,8" />
      <TextBlock Grid.Column="6" Text="Family" VerticalAlignment="Center" Margin="0,0,8,8" />
      <ComboBox Grid.Column="7" ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" Margin="0,0,0,8" />
      <TextBlock Grid.Row="1" Text="Interface" VerticalAlignment="Center" Margin="0,0,8,8" />
      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                ItemsSource="{Binding Interfaces}"
                DisplayMemberPath="Label"
                SelectedValuePath="Index"
                SelectedValue="{Binding SelectedInterfaceIndex}"
                Margin="0,0,16,8" />
      <TextBlock Grid.Row="1" Grid.Column="4" Text="Source" VerticalAlignment="Center" Margin="0,0,8,8" />
      <TextBox Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
      <StackPanel Grid.Row="2" Grid.ColumnSpan="8" Orientation="Horizontal" Margin="0,4,0,8">
        <Button Content="Trace" Command="{Binding RunTraceCommand}" Padding="16,4" Margin="0,0,8,0" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,4" />
      </StackPanel>
    </Grid>
    <ProgressBar Grid.Row="1" Height="8" Margin="0,0,0,8"
                 Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding Progress}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Reached" Margin="0,0,8,0" />
      <TextBlock Text="{Binding Reached}" Margin="0,0,16,0" />
      <TextBlock Text="Protocol" Margin="0,0,8,0" />
      <TextBlock Text="{Binding Protocol}" />
    </StackPanel>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid ItemsSource="{Binding Hops}"
                Style="{StaticResource DataGrid.Compact}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Ttl" Binding="{Binding Ttl}" Width="60" />
          <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Probes" Binding="{Binding Probes}" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
