<UserControl x:Class="Vestigium.Suite.Network.TraceIQ.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <StackPanel Margin="12" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
      <RadioButton Style="{DynamicResource RadioButton.HorizontalTab}" Content="TraceIQ"
                   IsChecked="{Binding TracePageOpen}" GroupName="SettingsPage" Margin="0,0,8,0" />
      <RadioButton Style="{DynamicResource RadioButton.HorizontalTab}" Content="Advanced"
                   IsChecked="{Binding AdvancedPageOpen}" GroupName="SettingsPage" Margin="0,0,8,0" />
      <RadioButton Style="{DynamicResource RadioButton.HorizontalTab}" Content="MRU"
                   IsChecked="{Binding MruPageOpen}" GroupName="SettingsPage" Margin="0,0,8,0" />
      <RadioButton Style="{DynamicResource RadioButton.HorizontalTab}" Content="Path Ping"
                   IsChecked="{Binding PathPageOpen}" GroupName="SettingsPage" Margin="0,0,8,0" />
      <RadioButton Style="{DynamicResource RadioButton.HorizontalTab}" Content="Theme"
                   IsChecked="{Binding ThemePageOpen}" GroupName="SettingsPage" />
    </StackPanel>

    <Border Style="{DynamicResource Border.Card}" Padding="20" MinWidth="520" HorizontalAlignment="Left">
      <Grid>
<StackPanel HorizontalAlignment="Left" Width="520" Margin="0"
                Visibility="{Binding TracePageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                 Text="The adapter the walk leaves on. Any lets Windows pick." />
      <Label Style="{StaticResource Label.Standard}" Content="Interface" />
      <ComboBox Style="{DynamicResource ComboBox.Standard}" ItemsSource="{Binding Interfaces}" DisplayMemberPath="Label" SelectedValuePath="Id"
                SelectedValue="{Binding SelectedInterfaceId}" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Source" />
      <ComboBox Style="{DynamicResource ComboBox.Standard}" ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedValuePath="Address"
                SelectedValue="{Binding Source}" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Family" />
      <ComboBox Style="{DynamicResource ComboBox.Standard}" ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left" Width="520" Margin="0"
                Visibility="{Binding AdvancedPageOpen, Converter={StaticResource BoolToVis}}">
      <Label Style="{StaticResource Label.Standard}" Content="Protocol" />
      <ComboBox Style="{DynamicResource ComboBox.Standard}" ItemsSource="{Binding Protocols}" SelectedItem="{Binding ProtocolChoice}" Margin="0,0,0,8" />
      <CheckBox Content="Second pass on silent hops" Style="{DynamicResource CheckBox.Standard}" IsChecked="{Binding SecondPass}"
                IsEnabled="{Binding SecondPassEnabled}" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Max hops" />
      <nud:VestigiumNumericUpDown Value="{Binding MaxHops}" Minimum="1" Maximum="64" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Parallel" />
      <nud:VestigiumNumericUpDown Value="{Binding Parallel}" Minimum="1" Maximum="30" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Probes (RTT)" />
      <nud:VestigiumNumericUpDown Value="{Binding Probes}" Minimum="1" Maximum="5" Margin="0,0,0,12" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left" Width="520" Margin="0"
                Visibility="{Binding MruPageOpen, Converter={StaticResource BoolToVis}}">
      <Label Style="{StaticResource Label.Standard}" Content="MRU max" />
      <nud:VestigiumNumericUpDown Value="{Binding MruMax}" Minimum="1" Maximum="30" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Sticky max" />
      <nud:VestigiumNumericUpDown Value="{Binding StickyMax}" Minimum="0" Maximum="10" Margin="0,0,0,12" />
      <TextBlock Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Stickies stay. They do not count against the MRU max." />
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Add" Style="{DynamicResource Button.Secondary}"
                Command="{Binding AddTargetCommand}" Padding="12,2" Margin="8,0,0,0" />
        <TextBox Style="{DynamicResource TextBox.Standard}" Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>
      <DataGrid Style="{DynamicResource DataGrid.Standard}" ItemsSource="{Binding Mru}"
                SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False"
                CanUserAddRows="False" HeadersVisibility="Column" MinHeight="160"
                CellEditEnding="ListEdited">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" IsReadOnly="True" />
          <DataGridCheckBoxColumn Header="Sticky" Binding="{Binding Sticky, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" />
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Up" Style="{DynamicResource Button.Secondary}" Command="{Binding MoveUpCommand}" Padding="12,2" Margin="0,0,8,0" />
        <Button Content="Down" Style="{DynamicResource Button.Secondary}" Command="{Binding MoveDownCommand}" Padding="12,2" Margin="0,0,8,0" />
        <Button Content="Remove" Style="{DynamicResource Button.Secondary}" Command="{Binding RemoveTargetCommand}" Padding="12,2" />
      </StackPanel>
    </StackPanel>

    <StackPanel HorizontalAlignment="Left" Width="640" Margin="0"
                Visibility="{Binding PathPageOpen, Converter={StaticResource BoolToVis}}">
      <Label Style="{StaticResource Label.Standard}" Content="Saturation" />
      <ComboBox Style="{DynamicResource ComboBox.Standard}" ItemsSource="{Binding Saturations}" SelectedValuePath="Level"
                SelectedValue="{Binding PathSaturation}" Margin="0,0,0,12">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="280" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Level}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Intent}" />
              <TextBlock Grid.Column="2" Text="{Binding Feel}" />
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Orientation="Horizontal" Visibility="{Binding CustomOpen, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
        <nud:VestigiumNumericUpDown Value="{Binding PathPingsPerMs}" Minimum="0.001" Maximum="1" Increment="0.001" DecimalPlaces="3" Width="110" />
        <TextBlock Style="{DynamicResource TextBlock.Standard}" Text="pings per millisecond" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
      <Label Style="{StaticResource Label.Standard}" Content="Hops at a time" />
      <nud:VestigiumNumericUpDown Value="{Binding PathWidth}" Minimum="1" Maximum="20" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Duration (seconds)" />
      <nud:VestigiumNumericUpDown Value="{Binding PathSeconds}" Minimum="1" Maximum="180" Margin="0,0,0,12" />
      <Label Style="{StaticResource Label.Standard}" Content="Dead after" />
      <nud:VestigiumNumericUpDown Value="{Binding PathDeadAfter}" Minimum="3" Maximum="30" Margin="0,0,0,12" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left" Width="420" Margin="0"
                Visibility="{Binding ThemePageOpen, Converter={StaticResource BoolToVis}}">
      <Label Style="{StaticResource Label.Standard}" Content="Palette" />
      <ComboBox Style="{DynamicResource ComboBox.Standard}" ItemsSource="{Binding Themes}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                SelectedValue="{Binding SelectedThemeId}" Margin="0,0,0,16" />
      <CheckBox Content="Status bar visible" Style="{DynamicResource CheckBox.Standard}"
                IsChecked="{Binding BarVisible}" Margin="0,0,0,16" />
      <Label Style="{StaticResource Label.Standard}" Content="Status bar dock" />
      <ComboBox Style="{DynamicResource ComboBox.Standard}" ItemsSource="{Binding BarPositions}" SelectedItem="{Binding BarPosition}" />
    </StackPanel>
        </Grid>
    </Border>

    <Button Content="Defaults" Style="{DynamicResource Button.Secondary}"
            Command="{Binding RestoreDefaultsCommand}" Padding="12,2" Margin="0,12,0,0"
            HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
