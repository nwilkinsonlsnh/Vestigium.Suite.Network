<Application x:Class="Vestigium.Suite.Network.TraceIQ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown">
  <Application.Resources>
    <Style TargetType="{x:Type nud:VestigiumNumericUpDown}"
           BasedOn="{StaticResource {x:Type nud:VestigiumNumericUpDown}}">
      <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
      <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
