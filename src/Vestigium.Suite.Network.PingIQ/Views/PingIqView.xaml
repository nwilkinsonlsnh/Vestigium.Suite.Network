<UserControl x:Class="Vestigium.Suite.Network.PingIQ.Views.PingIqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}" Text="{Binding Status}" Margin="0,0,0,12" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label Style="{StaticResource Label.Standard}" Content="Target" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Standard}"
                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
        <Button Grid.Column="2" Content="Echo" Style="{StaticResource Button.Primary}"
                Command="{Binding RunEchoCommand}" Padding="16,4" Margin="0,0,0,8" />
      </Grid>
    </DockPanel>

    <TextBox Grid.Row="1" Text="{Binding Log}" IsReadOnly="True"
             Style="{StaticResource TextBox.Standard}"
             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,12,0,0" />
  </Grid>
</UserControl>
