<UserControl x:Class="Vestigium.Suite.Network.PingIQ.Views.PingIqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}" Text="{Binding Status}" Margin="0,0,0,8" />
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}" Text="{Binding Summary}" Margin="0,0,0,12" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Style="{StaticResource Label.Standard}" Content="Target" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Standard}"
                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" />

        <Label Grid.Column="2" Style="{StaticResource Label.Standard}" Content="Count" VerticalAlignment="Center" Margin="0,0,8,8" />
        <nud:VestigiumNumericUpDown Grid.Column="3"
                                    Value="{Binding Count, Mode=TwoWay}"
                                    SignMode="Unsigned"
                                    Minimum="1" Maximum="99" Increment="1" PageIncrement="4" DecimalPlaces="0"
                                    MinWidth="128"
                                    Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                                    Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                    BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                                    Margin="0,0,16,8" />

        <Label Grid.Column="4" Style="{StaticResource Label.Standard}" Content="Delay (ms)" VerticalAlignment="Center" Margin="0,0,8,8" />
        <nud:VestigiumNumericUpDown Grid.Column="5"
                                    Value="{Binding TimeoutMs, Mode=TwoWay}"
                                    SignMode="Unsigned"
                                    Minimum="10" Maximum="60000" Increment="100" PageIncrement="1000" DecimalPlaces="0"
                                    MinWidth="136"
                                    Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                                    Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                    BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                                    Margin="0,0,0,8" />

        <Label Grid.Row="1" Style="{StaticResource Label.Standard}" Content="Interface" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                  Style="{StaticResource ComboBox.Standard}"
                  IsEditable="False"
                  ItemsSource="{Binding Interfaces}"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Index"
                  SelectedValue="{Binding SelectedInterfaceIndex, Mode=TwoWay}"
                  Margin="0,0,16,8" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Style="{StaticResource StackPanel.Toolbar}" Orientation="Horizontal">
          <Button Content="Ping" Style="{StaticResource Button.Primary}" Command="{Binding PingCommand}" Padding="16,4" Margin="0,0,8,0" />
          <Button Content="Probe" Style="{StaticResource Button.Success}" Command="{Binding ProbeCommand}" Padding="16,4" Margin="0,0,8,0" />
          <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Padding="16,4" />
        </StackPanel>
      </Grid>
    </DockPanel>

    <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid Style="{StaticResource DataGrid.Compact}"
                ItemsSource="{Binding Replies}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Auto"
                EnableRowVirtualization="True"
                ScrollViewer.CanContentScroll="True"
                PreviewMouseWheel="ReplyGrid_PreviewMouseWheel">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="60" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
          <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" />
          <DataGridTextColumn Header="RttMs" Binding="{Binding RttMs}" Width="80" />
          <DataGridTextColumn Header="Ttl" Binding="{Binding Ttl}" Width="60" />
          <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
