<UserControl x:Class="Vestigium.Suite.Network.NicIQ.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:Vestigium.Controls.UnderConstruction;assembly=Vestigium.Controls.UnderConstruction"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <Grid Margin="16">
    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,0,0,0"
                Visibility="{Binding WatchEmpty, Converter={StaticResource BoolToVis}}">
      <uc:VestigiumUnderConstruction />
      <TextBlock Style="{StaticResource TextBlock.Caption}" Text="No throughput chart yet." Margin="0,12,0,8" />
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                 Text="Select an adapter on NicIQ and Watch. Settings chooses Receive, Send, Errors, and Discards." />
      <TextBlock Margin="0,8,0,0">
        <Hyperlink Command="{Binding OpenNicIqCommand}">Open NicIQ</Hyperlink>
      </TextBlock>
    </StackPanel>
    <ScrollViewer Visibility="{Binding HasWatchData, Converter={StaticResource BoolToVis}}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ContentControl Content="{Binding ReceiveChart}" Margin="0,0,0,16" />
        <ContentControl Content="{Binding SendChart}" Margin="0,0,0,16" />
        <ContentControl Content="{Binding ErrorChart}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
