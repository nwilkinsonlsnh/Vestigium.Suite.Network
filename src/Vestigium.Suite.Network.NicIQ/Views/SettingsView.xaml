<UserControl x:Class="Vestigium.Suite.Network.NicIQ.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,12">
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                   Content="NicIQ"
                   IsChecked="{Binding NicIqPageOpen}"
                   GroupName="SettingsPage"
                   Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                   Content="Monitoring"
                   IsChecked="{Binding MonitoringPageOpen}"
                   GroupName="SettingsPage"
                   Margin="0,0,8,0" />
      <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                   Content="Theme"
                   IsChecked="{Binding ThemePageOpen}"
                   GroupName="SettingsPage" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="480"
                Margin="20,0,0,0"
                Visibility="{Binding NicIqPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                 Text="Defaults for the NicIQ page. Duration is seconds." />

      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Show Down"
                IsChecked="{Binding ShowDown}"
                Margin="0,0,0,12" />
      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Show Up"
                IsChecked="{Binding ShowUp}"
                Margin="0,0,0,12" />
      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Show IP Enabled &amp; IPv4"
                IsChecked="{Binding ShowIpv4}"
                Margin="0,0,0,12" />
      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Show IP Enabled &amp; IPv6"
                IsChecked="{Binding ShowIpv6}"
                Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Duration (s)" />
      <nud:VestigiumNumericUpDown Value="{Binding DefaultDurationSeconds, Mode=TwoWay}"
                                  SignMode="Unsigned"
                                  Minimum="1" Maximum="60" Increment="1" PageIncrement="5" DecimalPlaces="0" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="480"
                Margin="20,0,0,0"
                Visibility="{Binding MonitoringPageOpen, Converter={StaticResource BoolToVis}}">
      <TextBlock Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                 Text="Live charts sample the Network Interface counters they need. UCL and LCL are mean ± 3σ on the last 60 seconds." />
      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Show chart legend"
                IsChecked="{Binding ShowLegend}" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="420"
                Margin="20,0,0,0"
                Visibility="{Binding ThemePageOpen, Converter={StaticResource BoolToVis}}">
      <Label Style="{StaticResource Label.Standard}" Content="Palette" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding Themes}"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id"
                SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}"
                Margin="0,0,0,16" />

      <CheckBox Style="{StaticResource CheckBox.Standard}"
                Content="Status bar visible"
                IsChecked="{Binding BarVisible}"
                Margin="0,0,0,16" />

      <Label Style="{StaticResource Label.Standard}" Content="Status bar dock" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding BarPositions}"
                SelectedItem="{Binding BarPosition}" />
    </StackPanel>
  </DockPanel>
</UserControl>
