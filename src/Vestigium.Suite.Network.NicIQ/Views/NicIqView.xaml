<UserControl x:Class="Vestigium.Suite.Network.NicIQ.Views.NicIqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Style="{StaticResource TextBlock.Caption}"
               Text="{Binding Header}"
               Margin="0,0,0,8" />

    <StackPanel Grid.Row="1" Style="{StaticResource StackPanel.Toolbar}" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Padding="16,4" Margin="0,0,8,0" IsEnabled="False" />
      <CheckBox Style="{StaticResource CheckBox.Standard}" Content="Include down" IsChecked="True" Margin="0,0,16,0" IsEnabled="False" />
      <Label Style="{StaticResource Label.Standard}" Content="Duration" VerticalAlignment="Center" Margin="0,0,8,0" />
      <nud:VestigiumNumericUpDown Value="10"
                                  SignMode="Unsigned"
                                  Minimum="1" Maximum="60" Increment="1" PageIncrement="5" DecimalPlaces="0"
                                  Width="88"
                                  IsEnabled="False"
                                  Margin="0,0,8,0" />
      <Button Content="Watch" Style="{StaticResource Button.Primary}" Padding="16,4" Margin="0,0,8,0" IsEnabled="False" />
      <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Padding="16,4" IsEnabled="False" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   Text="Adapter list lands in PR01-02."
                   Margin="12"
                   TextWrapping="Wrap" />
      </Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   Text="{Binding Caption}"
                   Margin="12"
                   TextWrapping="Wrap" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
