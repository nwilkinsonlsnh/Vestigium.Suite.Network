<UserControl x:Class="Vestigium.Suite.Network.NicIQ.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="120" />
      <RowDefinition Height="*" MinHeight="240" />
    </Grid.RowDefinitions>

    <TextBlock Style="{StaticResource TextBlock.Caption}"
               Text="Live Network Interface counters. Primary NIC on open. Settings → Monitoring picks the set."
               TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <StackPanel Grid.Row="1" Style="{StaticResource StackPanel.Toolbar}" Orientation="Horizontal" Margin="0,0,0,8">
      <Label Style="{StaticResource Label.Standard}" Content="Active NIC" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding ActiveNics}"
                DisplayMemberPath="Name"
                SelectedItem="{Binding SelectedMonitorNic, Mode=TwoWay}"
                Width="360"
                Margin="0,0,12,0" />
      <TextBlock Style="{StaticResource TextBlock.Caption}"
                 Text="{Binding MonitorInstance, StringFormat=PDH  {0}}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1" Margin="0,0,0,8">
      <DataGrid Style="{StaticResource DataGrid.Compact}"
                ItemsSource="{Binding Samples}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True"
                VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Counter" Binding="{Binding Counter}" Width="2*" MinWidth="180" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" MinWidth="90" />
          <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" MinWidth="60" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" MinWidth="80" />
          <DataGridTextColumn Header="Time" Binding="{Binding Utc}" Width="90" MinWidth="80" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <DockPanel Grid.Row="3">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Throughput" IsChecked="{Binding ThroughputPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Packets" IsChecked="{Binding PacketsPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Integrity" IsChecked="{Binding IntegrityPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
        <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Utilization" IsChecked="{Binding UtilizationPageOpen}" GroupName="NicMonitorChart" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextBlock.Caption}" Text="{Binding ChartStrip}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <Grid>
          <TextBlock Style="{StaticResource TextBlock.Caption}" Text="Waiting for samples."
                     VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                     Visibility="{Binding ChartEmpty, Converter={StaticResource BoolToVis}}" />
          <ContentControl Content="{Binding LiveChart}"
                          Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
