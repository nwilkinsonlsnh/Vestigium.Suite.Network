<UserControl x:Class="Vestigium.Suite.Network.NicIQ.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="240" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Top" Margin="0,0,16,0">
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                   Text="Live counters. Network charts follow Active NIC. CPU and Memory are the machine."
                   TextWrapping="Wrap"
                   MaxWidth="360"
                   Margin="0,0,0,8" />
        <StackPanel Style="{StaticResource StackPanel.Toolbar}" Orientation="Horizontal">
          <Label Style="{StaticResource Label.Standard}" Content="Active NIC" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Style="{StaticResource ComboBox.Standard}"
                    ItemsSource="{Binding ActiveNics}"
                    DisplayMemberPath="Name"
                    SelectedItem="{Binding SelectedMonitorNic, Mode=TwoWay}"
                    Width="280"
                    Margin="0,0,12,0" />
        </StackPanel>
        <TextBlock Style="{StaticResource TextBlock.Caption}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                   Text="{Binding MonitorInstance, StringFormat=PDH  {0}}"
                   Margin="0,6,0,0" />
      </StackPanel>

      <Border Grid.Column="1"
              Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
              BorderThickness="1"
              Padding="16,10"
              VerticalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Margin="4,0,8,0"
                      MinWidth="92">
            <TextBlock Text="{Binding MonitorHeadlineTitle}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                       Visibility="{Binding HasMonitorHeadlineTitle, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding MonitorHeadline}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl Grid.Column="2" ItemsSource="{Binding MonitorFacts}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
                        <TextBlock Text="{Binding Value}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="1">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Throughput" IsChecked="{Binding ThroughputPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
          <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Packets" IsChecked="{Binding PacketsPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
          <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Integrity" IsChecked="{Binding IntegrityPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
          <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Utilization" IsChecked="{Binding UtilizationPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
          <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="CPU" IsChecked="{Binding CpuPageOpen}" GroupName="NicMonitorChart" Margin="0,0,8,0" />
          <RadioButton Style="{StaticResource RadioButton.HorizontalTab}" Content="Memory" IsChecked="{Binding MemoryPageOpen}" GroupName="NicMonitorChart" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Export Readings"
                  Command="{Binding ExportReadingsCommand}"
                  MinWidth="108"
                  Padding="12,4"
                  Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Import Readings"
                  Command="{Binding ImportReadingsCommand}"
                  MinWidth="108"
                  Padding="12,4"
                  Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="{Binding PauseButtonText}"
                  Command="{Binding TogglePauseCommand}"
                  MinWidth="88"
                  Padding="12,4"
                  Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="{Binding LegendButtonText}"
                  Command="{Binding ToggleLegendCommand}"
                  MinWidth="108"
                  Padding="12,4" />
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextBlock.Caption}" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" Text="{Binding ChartStrip}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
        <Grid>
          <ContentControl Content="{Binding LiveChart}"
                          Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}" />
          <Border Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
                  Opacity="0.92"
                  Visibility="{Binding ShowChartWarmup, Converter={StaticResource BoolToVis}}" />
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="360"
                      Visibility="{Binding ShowChartWarmup, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Preparing charts"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
            <TextBlock Text="{Binding ChartWarmStatus}"
                       Margin="0,8,0,12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
            <ProgressBar Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ChartWarmProgress}" />
          </StackPanel>
        </Grid>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
