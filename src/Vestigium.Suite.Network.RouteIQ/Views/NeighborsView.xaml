<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.NeighborsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="16,12,16,16">
    <StackPanel DockPanel.Dock="Top"
                Style="{StaticResource StackPanel.Toolbar}"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="0,0,0,12">
      <Button Content="Refresh"
              Style="{StaticResource Button.Primary}"
              Command="{Binding RefreshCommand}"
              Padding="16,4"
              Margin="0,0,8,0" />
      <Button Content="Copy"
              Style="{StaticResource Button.Secondary}"
              Command="{Binding CopyNeighborsCommand}"
              Padding="16,4" />
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Style="{StaticResource TextBlock.Caption}" Text="IPv4 Neighbor Cache" Margin="0,0,0,4" />
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
              BorderThickness="1"
              Margin="0,0,0,12"
              MinHeight="160">
        <DataGrid ItemsSource="{Binding Ipv4Neighbors}"
                  Style="{StaticResource DataGrid.Compact}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180" />
            <DataGridTextColumn Header="MacAddress" Binding="{Binding MacAddress}" Width="160" />
            <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="160" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <TextBlock Grid.Row="2" Style="{StaticResource TextBlock.Caption}" Text="IPv6 Neighbor Cache" Margin="0,0,0,4" />
      <Border Grid.Row="3"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
              BorderThickness="1"
              MinHeight="160">
        <DataGrid ItemsSource="{Binding Ipv6Neighbors}"
                  Style="{StaticResource DataGrid.Compact}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="260" />
            <DataGridTextColumn Header="MacAddress" Binding="{Binding MacAddress}" Width="160" />
            <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="160" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
