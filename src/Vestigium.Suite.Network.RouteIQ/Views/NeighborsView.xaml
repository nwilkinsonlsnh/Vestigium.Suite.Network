<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.NeighborsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Family" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Width="120"
                  Style="{StaticResource ComboBox.Standard}"
                  ItemsSource="{Binding Families}"
                  SelectedItem="{Binding Family}"
                  Margin="0,0,16,0" />
        <Button Content="Refresh"
                Style="{StaticResource Button.Primary}"
                Command="{Binding RefreshCommand}"
                Padding="16,4" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Neighbors}"
              Style="{StaticResource DataGrid.Compact}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180" />
        <DataGridTextColumn Header="MacAddress" Binding="{Binding MacAddress}" Width="160" />
        <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="160" />
        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
