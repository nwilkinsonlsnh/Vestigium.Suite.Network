<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.NeighborsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid Margin="16,12,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Style="{StaticResource StackPanel.Toolbar}" Orientation="Horizontal" Margin="0,0,0,12">
      <Label Style="{StaticResource Label.Standard}" Content="Family" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="120"
                Style="{StaticResource ComboBox.Standard}"
                ItemsSource="{Binding Families}"
                SelectedItem="{Binding Family}"
                Margin="0,0,16,0" />
      <Button Content="Refresh"
              Style="{StaticResource Button.Primary}"
              Command="{Binding RefreshCommand}"
              Padding="16,4" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid ItemsSource="{Binding Neighbors}"
                Style="{StaticResource DataGrid.Compact}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180" />
          <DataGridTextColumn Header="MacAddress" Binding="{Binding MacAddress}" Width="160" />
          <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="160" />
          <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
