<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.NeighborsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}"
             SizeChanged="OnSizeChanged">
  <DockPanel Margin="16,12,16,16">
    <StackPanel x:Name="Toolbar"
                DockPanel.Dock="Top"
                Style="{StaticResource StackPanel.Toolbar}"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="0,0,0,12">
      <Button Content="Refresh"
              Style="{StaticResource Button.Primary}"
              Command="{Binding RefreshCommand}"
              Padding="16,4"
              Margin="0,0,8,0" />
      <Button Content="Copy"
              Style="{StaticResource Button.Secondary}"
              Command="{Binding CopyNeighborsCommand}"
              Padding="16,4" />
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="276" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="Ipv4Caption"
                 Grid.Row="0"
                 Style="{StaticResource TextBlock.Caption}"
                 Text="IPv4 Neighbor Cache"
                 Margin="0,0,0,4" />
      <Border x:Name="Ipv4Host"
              Grid.Row="1"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
              BorderThickness="1"
              Margin="0,0,0,12">
        <Grid>
          <DataGrid ItemsSource="{Binding Ipv4Neighbors}"
                    Style="{StaticResource DataGrid.Compact}"
                    RowHeight="28"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    VerticalAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180" />
              <DataGridTextColumn Header="Class" Binding="{Binding ClassText}" Width="70" />
              <DataGridTextColumn Header="MacAddress" Binding="{Binding MacAddress}" Width="160" />
              <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="180" />
              <DataGridTextColumn Header="InterfaceIndex" Binding="{Binding InterfaceIndex}" Width="120" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
              <DataGridTextColumn Header="IsMulticast" Binding="{Binding IsMulticast}" Width="110" />
              <DataGridTextColumn Header="Vendor" Binding="{Binding VendorText}" Width="180" />
              <DataGridTextColumn Header="RTT (ms)" Binding="{Binding RttMs}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <TextBlock x:Name="Ipv6Caption"
                 Grid.Row="2"
                 Style="{StaticResource TextBlock.Caption}"
                 Text="IPv6 Neighbor Cache"
                 Margin="0,0,0,4" />
      <Border Grid.Row="3"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
              BorderThickness="1"
              Height="276">
        <Grid>
          <DataGrid ItemsSource="{Binding Ipv6Neighbors}"
                    Style="{StaticResource DataGrid.Compact}"
                    RowHeight="28"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    VerticalAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180" />
              <DataGridTextColumn Header="Class" Binding="{Binding ClassText}" Width="70" />
              <DataGridTextColumn Header="MacAddress" Binding="{Binding MacAddress}" Width="160" />
              <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="180" />
              <DataGridTextColumn Header="InterfaceIndex" Binding="{Binding InterfaceIndex}" Width="120" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
              <DataGridTextColumn Header="IsMulticast" Binding="{Binding IsMulticast}" Width="110" />
              <DataGridTextColumn Header="Vendor" Binding="{Binding VendorText}" Width="160" />
              <DataGridTextColumn Header="RTT (ms)" Binding="{Binding RttMs}" Width="90" />
              <DataGridTextColumn Header="IsRouter" Binding="{Binding IsRouter}" Width="90" />
              <DataGridTextColumn Header="LastReachable" Binding="{Binding LastReachableText}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
