<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.LmHostsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="16,12,16,16">
    <StackPanel DockPanel.Dock="Top"
                Style="{StaticResource StackPanel.Toolbar}"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="0,0,0,12">
      <Button Content="Refresh"
              Style="{StaticResource Button.Primary}"
              Command="{Binding RefreshCommand}"
              Padding="16,4"
              Margin="0,0,8,0" />
      <Button Content="Copy"
              Style="{StaticResource Button.Secondary}"
              Command="{Binding CopyLmHostsCommand}"
              Padding="16,4" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top"
               Style="{StaticResource TextBlock.Caption}"
               Text="{Binding LmHostSummary}"
               Margin="0,0,0,4" />
    <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid ItemsSource="{Binding LmHosts}"
                Style="{StaticResource DataGrid.Compact}"
                RowHeight="28"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="160" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
          <DataGridTextColumn Header="Preload" Binding="{Binding Preload}" Width="90" />
          <DataGridTextColumn Header="Domain" Binding="{Binding Domain, TargetNullValue=--}" Width="140" />
          <DataGridTextColumn Header="MultiHome" Binding="{Binding MultiHome}" Width="110" />
          <DataGridTextColumn Header="Include" Binding="{Binding IncludePath, TargetNullValue=--}" Width="220" />
          <DataGridTextColumn Header="Raw" Binding="{Binding Raw, TargetNullValue=--}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
