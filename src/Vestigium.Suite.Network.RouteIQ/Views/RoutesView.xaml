<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <DockPanel Margin="16,12,16,16">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel Style="{StaticResource StackPanel.Toolbar}" Orientation="Horizontal" HorizontalAlignment="Left">
        <Label Style="{StaticResource Label.Standard}" Content="Family" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Width="120"
                  Style="{StaticResource ComboBox.Standard}"
                  ItemsSource="{Binding Families}"
                  SelectedItem="{Binding Family}"
                  Margin="0,0,16,0" />
        <Button Content="Refresh"
                Style="{StaticResource Button.Primary}"
                Command="{Binding RefreshCommand}"
                Padding="16,4" />
      </StackPanel>
      <Button Content="Copy"
              Style="{StaticResource Button.Secondary}"
              Command="{Binding CopyCommand}"
              Padding="16,4"
              HorizontalAlignment="Right" />
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="180" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource TextBlock.Caption}"
                   Text="IPv4 Route Table"
                   Margin="0,0,0,4"
                   Visibility="{Binding ShowIpv4, Converter={StaticResource BoolToVis}}" />
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                BorderThickness="1"
                Margin="0,0,0,12"
                Visibility="{Binding ShowIpv4, Converter={StaticResource BoolToVis}}">
          <DataGrid ItemsSource="{Binding Ipv4Routes}"
                    Style="{StaticResource DataGrid.Compact}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="160" />
              <DataGridTextColumn Header="PrefixLength" Binding="{Binding PrefixLength}" Width="100" />
              <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="140" />
              <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="160" />
              <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="140" />
              <DataGridTextColumn Header="InterfaceIndex" Binding="{Binding InterfaceIndex}" Width="110" />
              <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80" />
              <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <TextBlock Grid.Row="2"
                   Style="{StaticResource TextBlock.Caption}"
                   Text="IPv6 Route Table"
                   Margin="0,0,0,4"
                   Visibility="{Binding ShowIpv6, Converter={StaticResource BoolToVis}}" />
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                BorderThickness="1"
                Visibility="{Binding ShowIpv6, Converter={StaticResource BoolToVis}}">
          <DataGrid ItemsSource="{Binding Ipv6Routes}"
                    Style="{StaticResource DataGrid.Compact}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="220" />
              <DataGridTextColumn Header="PrefixLength" Binding="{Binding PrefixLength}" Width="100" />
              <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="140" />
              <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="180" />
              <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="140" />
              <DataGridTextColumn Header="InterfaceIndex" Binding="{Binding InterfaceIndex}" Width="110" />
              <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80" />
              <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
