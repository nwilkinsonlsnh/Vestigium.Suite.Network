<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <DockPanel Margin="16,12,16,16">
    <StackPanel DockPanel.Dock="Top"
                Style="{StaticResource StackPanel.Toolbar}"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="0,0,0,12">
      <Button Content="Refresh"
              Style="{StaticResource Button.Primary}"
              Command="{Binding RefreshCommand}"
              Padding="16,4"
              Margin="0,0,8,0" />
      <Button Content="Copy"
              Style="{StaticResource Button.Secondary}"
              Command="{Binding CopyCommand}"
              Padding="16,4" />
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="276" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Style="{StaticResource TextBlock.Caption}"
                 Text="IPv4 Route Table"
                 Margin="0,0,0,4" />
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
              BorderThickness="1"
              Margin="0,0,0,12">
        <DataGrid ItemsSource="{Binding Ipv4Routes}"
                  Style="{StaticResource DataGrid.Compact}"
                  RowHeight="28"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="160" />
            <DataGridTextColumn Header="PrefixLength" Binding="{Binding PrefixLength}" Width="100" />
            <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="140" />
            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="160" />
            <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="140" />
            <DataGridTextColumn Header="InterfaceIndex" Binding="{Binding InterfaceIndex}" Width="110" />
            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80" />
            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <TextBlock Grid.Row="2"
                 Style="{StaticResource TextBlock.Caption}"
                 Text="IPv6 Route Table"
                 Margin="0,0,0,4" />
      <Border Grid.Row="3"
              BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
              BorderThickness="1"
              Height="276">
        <DataGrid ItemsSource="{Binding Ipv6Routes}"
                  Style="{StaticResource DataGrid.Compact}"
                  RowHeight="28"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="220" />
            <DataGridTextColumn Header="PrefixLength" Binding="{Binding PrefixLength}" Width="100" />
            <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="140" />
            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="180" />
            <DataGridTextColumn Header="InterfaceName" Binding="{Binding InterfaceName}" Width="140" />
            <DataGridTextColumn Header="InterfaceIndex" Binding="{Binding InterfaceIndex}" Width="110" />
            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80" />
            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
