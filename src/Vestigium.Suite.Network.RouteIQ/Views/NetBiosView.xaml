<UserControl x:Class="Vestigium.Suite.Network.RouteIQ.Views.NetBiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <UserControl.Resources>
    <CollectionViewSource x:Key="NetBiosGroups" Source="{Binding NetBiosNames}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Adapter" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>
  <DockPanel Margin="16,12,16,16">
    <StackPanel DockPanel.Dock="Top"
                Style="{StaticResource StackPanel.Toolbar}"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="0,0,0,12">
      <Button Content="Refresh"
              Style="{StaticResource Button.Primary}"
              Command="{Binding RefreshCommand}"
              Padding="16,4"
              Margin="0,0,8,0" />
      <Button Content="Copy"
              Style="{StaticResource Button.Secondary}"
              Command="{Binding CopyNetBiosCommand}"
              Padding="16,4" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top"
               Style="{StaticResource TextBlock.Caption}"
               Text="{Binding NetBiosSummary}"
               Margin="0,0,0,4" />
    <Border BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" BorderThickness="1">
      <DataGrid ItemsSource="{Binding Source={StaticResource NetBiosGroups}}"
                Style="{StaticResource DataGrid.Compact}"
                RowHeight="28"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                VerticalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
        <DataGrid.GroupStyle>
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                      <Expander IsExpanded="True"
                                Background="Transparent"
                                Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                                Margin="4,4,0,0">
                        <Expander.Header>
                          <TextBlock Style="{StaticResource TextBlock.Caption}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                                     Text="{Binding Name, TargetNullValue=--}" />
                        </Expander.Header>
                        <ItemsPresenter />
                      </Expander>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="IsCache" Binding="{Binding IsCache}" Width="80" />
          <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter, TargetNullValue=--}" Width="160" />
          <DataGridTextColumn Header="NodeAddress" Binding="{Binding NodeAddress, TargetNullValue=--}" Width="140" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
          <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix}" Width="70" />
          <DataGridTextColumn Header="SuffixName" Binding="{Binding SuffixName}" Width="140" />
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status, TargetNullValue=--}" Width="110" />
          <DataGridTextColumn Header="Address" Binding="{Binding Address, TargetNullValue=--}" Width="140" />
          <DataGridTextColumn Header="LifeSeconds" Binding="{Binding LifeSeconds, TargetNullValue=--}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
