<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Button.QueryIcon" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToggleButton.QueryIcon" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Sunken}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Button.QueryMru" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Button.QueryPin" TargetType="Button" BasedOn="{StaticResource Button.QueryMru}">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="Content" Value="&#xE718;" />
    <Setter Property="Width" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="ToolTip" Value="Pin" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Sticky}" Value="True">
        <Setter Property="Content" Value="&#xE841;" />
        <Setter Property="ToolTip" Value="Unpin" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ListBox.QueryComplete" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Padding" Value="8,4" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
