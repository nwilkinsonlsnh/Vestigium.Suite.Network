<Window x:Class="Vestigium.Suite.Network.RouteIQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Vestigium.Controls.Shell;assembly=Vestigium.Controls"
        Title="RouteIQ"
        Height="920" Width="1380"
        MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Grid>
    <DockPanel Style="{StaticResource DockPanel.Standard}">
      <Grid DockPanel.Dock="Top" Margin="12,8,12,0">
        <ItemsControl HorizontalAlignment="Left"
                      ItemsSource="{Binding NavItems, ElementName=RootShell}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource RadioButton.HorizontalTab}"
                           Content="{Binding Header}"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           IsEnabled="{Binding IsEnabled}"
                           GroupName="RouteIqMainNav"
                           Checked="MainNav_Checked"
                           Click="MainNav_Click"
                           Margin="0,0,8,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <RadioButton x:Name="HelpTab"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Content="Help"
                     Style="{StaticResource RadioButton.HorizontalTab}"
                     GroupName="RouteIqMainNav"
                     Checked="HelpTab_Checked"
                     Unchecked="HelpTab_Unchecked"
                     Margin="8,0,0,0" />
      </Grid>
      <shell:VestigiumShell x:Name="RootShell"
                            ShowNav="False"
                            Status="{Binding Status}"
                            StatusBarPosition="{Binding Status.Position, Mode=TwoWay}"
                            ShowStatusBar="{Binding ShowStatusBar}" />
    </DockPanel>
    <Grid x:Name="Splash" Background="{DynamicResource Vestigium.Brushes.Surface.Window}" Visibility="Collapsed">
      <StackPanel Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="RouteIQ" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" Margin="0,0,0,8" />
        <TextBlock x:Name="SplashStatus" Text="Opening" Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,12" />
        <ProgressBar x:Name="SplashBar" Height="8" Minimum="0" Maximum="100" Value="0" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
