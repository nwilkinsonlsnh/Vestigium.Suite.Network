<Window x:Class="Vestigium.Suite.Network.RouteIQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RouteIQ" Height="420" Width="720">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="RouteIQ" Margin="0,0,0,12" />
    <DockPanel>
      <Button DockPanel.Dock="Top" Content="Print routes" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Padding="16,4" Margin="0,0,0,8" />
      <TextBox Text="{Binding Log}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
    </DockPanel>
  </DockPanel>
</Window>
