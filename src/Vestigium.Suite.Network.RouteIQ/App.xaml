<Application x:Class="Vestigium.Suite.Network.RouteIQ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nud="clr-namespace:Vestigium.Controls.NumericUpDown;assembly=Vestigium.Controls.NumericUpDown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Views/QueryMru.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="{x:Type nud:VestigiumNumericUpDown}"
             BasedOn="{StaticResource {x:Type nud:VestigiumNumericUpDown}}">
        <Setter Property="TextAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
