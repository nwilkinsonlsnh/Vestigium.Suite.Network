<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Vestigium.Suite.Network.Shell</RootNamespace>
    <AssemblyName>Vestigium.Suite.Network.Shell</AssemblyName>
    <Description>Shared chrome for Network suite hosts: logging init, bind fields. Not a protocol API.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Vestigium.Logging" Version="$(VestigiumLoggingVersion)" />
    <PackageReference Include="Vestigium.Helpers.Analytics" Version="$(VestigiumAnalyticsVersion)" />
    <PackageReference Include="Vestigium.Helpers.Charts" Version="$(VestigiumChartsVersion)" />
    <PackageReference Include="Vestigium.Helpers.Network" Version="$(VestigiumNetworkVersion)" />
    <!-- Ensure DI Abstractions present at runtime for packages that depend on it -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
